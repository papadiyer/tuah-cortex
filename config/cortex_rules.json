{
  "version": "0.1",
  "limits": {
    "user_char_limit": 1375,
    "memory_char_limit": 2200
  },
  "retrieval": {
    "vector_top_k": 5,
    "graph_top_k": 5,
    "min_score": 0.02,
    "merged_max_items": 12,
    "expert_top_k": 5,
    "expert_boost": 1.0
  },
  "curator": {
    "min_segment_chars": 16,
    "max_segment_chars": 600,
    "skip_roles": [],
    "classification_margin": 0.0
  },
  "embedding": {
    "backend": "deterministic",
    "dimensions": 512,
    "ngram_size": 4,
    "ngram_weight": 0.35
  },
  "classification": {
    "experience_keywords": [
      "file", "files", "folder", "directory", "path", "module", "package",
      "import", "imports", "dependency", "dependencies", "architecture",
      "repo", "repository", "codebase", "function", "class", "method",
      "schema", "migration", "endpoint", "api", "commit", "branch",
      "refactor", "test", "tests", "script", "build", "pipeline", "sqlite",
      "database table", "structure", "call", "calls", "wired", "wires"
    ],
    "knowledge_keywords": [
      "prefer", "prefers", "preference", "preferences", "likes", "dislikes",
      "always", "never", "rule", "rules", "policy", "config", "setting",
      "settings", "limit", "budget", "decision", "decided", "standard",
      "convention", "requirement", "fact", "remember", "note", "goal",
      "deadline", "owner", "authority", "language", "timezone"
    ],
    "experience_patterns": [
      "(?m)^\\s*(?:from|import)\\s+[A-Za-z_][\\w.]*",
      "[\\w./-]+\\.(?:py|js|ts|tsx|json|sh|md|ya?ml|toml|sql|txt)\\b",
      "```",
      "(?:^|\\s)(?:/|\\./|~/)[\\w./-]+",
      "\\bdef\\s+\\w+\\s*\\(",
      "\\bclass\\s+\\w+\\s*[:(]"
    ]
  },
  "expert_axes": {
    "_comment": "Mixture-of-Experts at the memory layer (docs/EXPERT_AXIS_ROUTING_v0.5.md). Adding an axis here + in identity.json persona.expert_axes routes and tags it with NO code change. Weights baselined on tests/golden/expert_routing.jsonl, not guessed.",
    "default_weight": 0.0,
    "min_confidence": 0.3,
    "saturation": 1.0,
    "axes": {
      "telco_presales": {
        "keywords": [
          "proposal", "sla", "5g", "private network", "boq", "rfi", "rfp",
          "presales", "customer", "commercial", "ran", "core network",
          "tender", "bandwidth"
        ],
        "weight": 1.0
      },
      "linux_pro": {
        "keywords": [
          "proxmox", "zfs", "ssh", "systemd", "debian", "ubuntu", "fstab",
          "cron", "iptables", "firewall", "lvm", "kernel", "daemon",
          "journalctl", "mount", "swap"
        ],
        "weight": 1.0
      },
      "technologist": {
        "keywords": [
          "api", "architecture", "model", "inference", "vector", "embedding",
          "rag", "docker", "kubernetes", "gpu", "token", "latency"
        ],
        "weight": 0.8
      },
      "cto": {
        "keywords": [
          "trade-off", "tradeoff", "build vs buy", "buy vs build", "governance",
          "architecture decision", "tech debt", "roadmap", "postmortem"
        ],
        "weight": 1.0,
        "experience_only": true
      },
      "founder": {
        "keywords": [
          "gtm", "burn rate", "pricing", "mvp", "product-market", "hire",
          "hiring", "funding", "pivot", "unit economics", "runway"
        ],
        "weight": 1.0,
        "experience_only": true
      }
    }
  },
  "paths": {
    "data_dir": "data",
    "vector_db": "data/vector_store.db",
    "graph_db": "data/graph_store.db",
    "queue_db": "data/event_queue.db",
    "sample_log": "data/sample_conversation.jsonl"
  },
  "service": {
    "host": "127.0.0.1",
    "port": 8765,
    "max_prompt_chars": 32000,
    "max_token_budget": 8192,
    "max_body_bytes": 262144,
    "queue_max_attempts": 5,
    "worker_poll_seconds": 1.0
  }
}
