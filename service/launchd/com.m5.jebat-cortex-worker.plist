<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Jebat-Cortex ingest worker - macOS launchd agent.

  The API only enqueues events; THIS process turns them into curated memory.
  Running the API without this worker leaves the queue growing and undrained
  (/v1/health reports a rising queue_depth). Both jobs must be loaded - see
  docs/SERVICE_OPERATIONS.md, "The co-launch mechanism".

  It resets any 'processing' rows left by a crash back to 'queued' on boot, so
  no event is stranded.

  Install:
    cp service/launchd/com.m5.jebat-cortex-worker.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.m5.jebat-cortex-worker.plist

  Paths: launchd does NOT expand ~ or $VAR in WorkingDirectory or
  StandardOutPath, so the repo location is resolved inside a /bin/sh wrapper
  (which does expand) and no user's home directory is hardcoded here.
  Override with `launchctl setenv CORTEX_HOME|CORTEX_PYTHON ...` before load.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.m5.jebat-cortex-worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>set -eu
CORTEX_HOME="${CORTEX_HOME:-$HOME/dev/projects/the-magnificent-5/jebat-cortex}"
PYTHON="${CORTEX_PYTHON:-python3}"
cd "$CORTEX_HOME"
mkdir -p logs
exec >>logs/cortex-worker.out.log 2>>logs/cortex-worker.err.log
export PYTHONPATH="$CORTEX_HOME"
export PYTHONUNBUFFERED=1
exec "$PYTHON" -m workers.ingest_worker
</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
