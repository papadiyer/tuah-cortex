<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Jebat-Cortex API (serve) - macOS launchd agent.

  Install (per-user LaunchAgent, no sudo):
    cp service/launchd/com.m5.jebat-cortex.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.m5.jebat-cortex.plist
    curl -s http://127.0.0.1:8765/v1/health

  THIS IS HALF THE SYSTEM. Also load com.m5.jebat-cortex-worker.plist, or the
  API will accept events into the queue and nothing will ever drain them.
  See docs/SERVICE_OPERATIONS.md.

  Paths: launchd does NOT expand ~ or $VAR in WorkingDirectory,
  StandardOutPath or ProgramArguments - those keys are taken literally. So the
  repo location is resolved inside a /bin/sh wrapper, which does expand, and no
  user's home directory is hardcoded in this file. Override the defaults with:
    launchctl setenv CORTEX_HOME   /path/to/jebat-cortex
    launchctl setenv CORTEX_PYTHON /path/to/venv/bin/python3
    launchctl setenv CORTEX_PORT   8765
  (run those BEFORE `launchctl load`, or unload/load afterwards).

  CORTEX_ADMIN_TOKEN is intentionally NOT set here - a plist in the repo must
  never carry a secret. Export it via `launchctl setenv` if you need the admin
  routes.

  The API binds 127.0.0.1 only; this agent never exposes a public port.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.m5.jebat-cortex</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>set -eu
CORTEX_HOME="${CORTEX_HOME:-$HOME/dev/projects/the-magnificent-5/jebat-cortex}"
PYTHON="${CORTEX_PYTHON:-/Users/faisal/dev/projects/the-magnificent-5/jebat-cortex/.venv-cortex-st/bin/python}"
cd "$CORTEX_HOME"
mkdir -p logs
exec >>logs/cortex-api.out.log 2>>logs/cortex-api.err.log
export PYTHONPATH="$CORTEX_HOME"
export PYTHONUNBUFFERED=1
exec "$PYTHON" -m cli.cortex_cli serve --host 127.0.0.1 --port "${CORTEX_PORT:-8765}"
</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
